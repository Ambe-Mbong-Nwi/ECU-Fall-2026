    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "1f99542b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[ 0.41665471 -0.90906482]\n",
      "0.6552842265029633\n"
     ]
    }
   ],
   "source": [
    "a = np.array([2.3,4.4])\n",
    "b = np.array([6.7,-5.2])\n",
    "p = np.array([4.1, -1.1])\n",
    "\n",
    "n = b-a\n",
    "n_hat = n/np.linalg.norm(n)\n",
    "#n_hat = n/np.sqrt(np.dot(n,n))\n",
    "\n",
    "print(n_hat)\n",
    "\n",
    "v = p-a\n",
    "\n",
    "c = np.dot(v,n_hat)*n_hat + a\n",
    "\n",
    "d = np.linalg.norm(p-c)\n",
    "\n",
    "print(d)"
   ]
